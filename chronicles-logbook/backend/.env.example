DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/chronicles
DATABASE_SSL=false
JWT_SECRET_KEY=your-long-random-jwt-secret
CORS_ORIGINS=http://localhost:5173
SQL_DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_SECRET_KEY=your-long-random-session-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your-brevo-smtp-username
BREVO_SMTP_PASSWORD=your-brevo-smtp-password
MAIL_FROM=your-verified-sender-email
MAIL_FROM_NAME=Chronicles

PASSWORD_RESET_EXPIRE_MINUTES=60
