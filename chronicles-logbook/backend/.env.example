DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/chronicles
DATABASE_SSL=false
JWT_SECRET_KEY=your-long-random-jwt-secret
CORS_ORIGINS=http://localhost:5173
SQL_DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_SECRET_KEY=your-long-random-session-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/calendar/callback

# Local development only. The team's shared Google OAuth client only has
# localhost registered for whoever administers it, so if Google sign-in
# doesn't work for you locally, set this to true and use the "Continue
# without Google" option that appears on the sign-in page while the frontend
# is running via `npm run dev`. Leave it false (or unset) anywhere else, and
# NEVER set it in Azure Application Settings — it lets anyone sign in as any
# email with no password or Google account required.
ENABLE_DEV_LOGIN=false

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Production / Azure deployment URLs
# CORS_ORIGINS=https://chronicles-drivenbydesign-app-hfeehwdce7dfd9fr.uaenorth-01.azurewebsites.net
# FRONTEND_URL=https://chronicles-drivenbydesign-app-hfeehwdce7dfd9fr.uaenorth-01.azurewebsites.net
# OAUTH_REDIRECT_URI=https://chronicles-drivenbydesign-api-gub5h0e8aee0gcb0.uaenorth-01.azurewebsites.net/auth/google/callback
# GOOGLE_CALENDAR_REDIRECT_URI=https://chronicles-drivenbydesign-api-gub5h0e8aee0gcb0.uaenorth-01.azurewebsites.net/auth/google/calendar/callback

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your-brevo-smtp-username
BREVO_SMTP_PASSWORD=your-brevo-smtp-password
MAIL_FROM=your-verified-sender-email
MAIL_FROM_NAME=Chronicles

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
